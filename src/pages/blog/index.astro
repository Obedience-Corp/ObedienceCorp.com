---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Writing — Obedience Corp"
  description="Field notes on building and operating dependable AI systems."
  current="/blog"
>
  <section class="index">
    <header class="index-head">
      <p class="eyebrow">WRITING / FIELD NOTES</p>
      <h1>Evidence from building AI systems in the real world.</h1>
      <p>
        Technical essays, operating lessons, and honest reports from the work
        behind Obedience Corp.
      </p>
    </header>
    {posts.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post, index) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <span class="post-meta post-rail">
                <span>{String(index + 1).padStart(2, "0")} / FIELD NOTE</span>
                <span>{post.data.date.toISOString().slice(0, 10)}</span>
              </span>
              <span class="post-copy">
                <span class="post-title">{post.data.title}</span>
                <p class="post-dek">{post.data.summary}</p>
                <span class="post-card-link">READ →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
