---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical =
  post.data.canonical ?? `https://obediencecorp.com/blog/${post.id}/`;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonical}
  ogType="article"
  ogImage={post.data.ogImage}
>
  <article class="post">
    <header class="post-header">
      <p class="mono-label">
        <a href="/blog/">Blog</a>
        <span aria-hidden="true"> / </span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.draft && <span class="draft-flag">Draft</span>}
      </p>
      <h1 class="post-h1">{post.data.title}</h1>
      <p class="post-byline">By {post.data.author}</p>
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 68ch;
    margin: 0 auto;
    padding: clamp(4rem, 9vh, 7rem) clamp(1.25rem, 3vw, 3.5rem);
  }

  .post-header {
    margin-bottom: clamp(2.5rem, 5vh, 3.5rem);
  }

  .post-h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-ink-primary);
    margin: 1rem 0 1rem;
  }

  .post-byline {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0 0 1.25rem;
  }

  .draft-flag {
    margin-left: 0.75rem;
  }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .post-tags li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    border: 1px solid var(--color-rule);
    padding: 0.25rem 0.5rem;
  }

  .post-body {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-body);
  }

  .post-body :global(h2) {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.125rem, 1.75vw, 1.375rem);
    letter-spacing: -0.005em;
    color: var(--color-ink-primary);
    margin: 3rem 0 1rem;
  }

  .post-body :global(p) {
    margin: 0 0 1.5em;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.75em;
    padding-left: 1.25rem;
  }

  .post-body :global(li + li) {
    margin-top: 0.35em;
  }

  .post-body :global(a) {
    color: var(--color-ink-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(strong) {
    font-weight: 600;
    color: var(--color-ink-primary);
  }

  .post-body :global(blockquote) {
    margin: 3rem 0;
    padding: 2rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-ink-primary);
  }
</style>
