---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} — Obedience Corp`}
  description={post.data.summary}
  current="/blog"
  image={post.data.image}
>
  <article class="article">
    <header class="article-head">
      <div class="article-signal">
        <p class="post-meta">
          <a href="/blog">← FIELD NOTES</a><br />
          {post.data.author}<br />
          {post.data.date.toISOString().slice(0, 10)}
        </p>
      </div>
      <div class="article-title-block">
        <p class="eyebrow">OBEDIENCE CORP / FIELD NOTE</p>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.summary}</p>
      </div>
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Base>

<script>
  import { mountMermaid } from "../../lib/mermaid";
  mountMermaid();
</script>
