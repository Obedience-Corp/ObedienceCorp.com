---
import Base from "../../layouts/Base.astro";

// The licensing service. With nothing configured the page shows the manual
// delivery message and makes no request at all, which is the whole post
// purchase experience if the owner never deploys a service.
const LICENSE_API = import.meta.env.PUBLIC_FA_LICENSE_API ?? "";

// Where a buyer writes when the key does not arrive. The address is an owner
// decision, like the price. Until one is set the page names the contact form,
// which is a real route on this site, rather than an address that might not
// exist or a "contact us" with no way to.
const SUPPORT_EMAIL = import.meta.env.PUBLIC_FA_SUPPORT_EMAIL ?? "";

const RELEASES =
  "https://github.com/Obedience-Corp/festival-activity-releases/releases/latest";
---

<Base
  title="Your Festival Activity key"
  description="Your Festival Activity license key and downloads."
  analytics={false}
  noindex
>
  <section class="inner-hero fa-thanks-hero">
    <p class="eyebrow">PAYMENT RECEIVED</p>
    <h1>Thank you.</h1>
    <p>
      Your payment went through. Your license key is below, and the downloads
      are underneath it.
    </p>
  </section>

  <section class="work-case fa-key-section">
    <div id="fa-working" class="fa-panel">
      <p class="section-label">PREPARING YOUR KEY</p>
      <p class="fa-panel-lede">This takes a few seconds.</p>
      <p>
        Stripe tells us about the payment a moment after it sends you here, so
        this page waits for it. Leave it open.
      </p>
    </div>

    <div id="fa-key" class="fa-panel" hidden>
      <p class="section-label">YOUR LICENSE KEY</p>
      <p class="fa-key-value"><code id="fa-key-text">&nbsp;</code></p>
      <button id="fa-copy" class="action action-secondary" type="button">
        Copy key
      </button>
      <p class="fa-key-note">
        This page is the only place your key is shown. Save it now. If you lose
        it, a person can find it for you, but there is no automated recovery and
        it is not on your receipt.
      </p>
      <p id="fa-licensee" class="fa-key-note" hidden></p>
    </div>

    <div id="fa-fallback" class="fa-panel" hidden>
      <p class="section-label">YOUR KEY IS NOT READY YET</p>
      <p class="fa-panel-lede">
        Your payment went through. The key is not ready on this page yet.
      </p>
      <p>
        Nothing is lost. Keep this page open and it will appear here, or come
        back to this exact link later: the address in your browser's bar is what
        finds your key, so bookmark it or save it somewhere before you close the
        tab. It works for 24 hours.
      </p>
      <p>
        If it is still not here after that, or you have already closed the page,
        {
          SUPPORT_EMAIL ? (
            <>
              {" "}
              write to <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
            </>
          ) : (
            <>
              {" "}
              write through the <a href="/#contact">contact form</a>
            </>
          )
        } with the email address you paid with. A person will read it and send you
        the key by hand.
      </p>
    </div>
  </section>

  <section class="work-case client-work">
    <header class="work-case-head">
      <div>
        <p class="section-label">DOWNLOADS</p>
        <h2>Pick the one for your machine.</h2>
      </div>
      <p>MACOS AND LINUX</p>
    </header>

    <div class="work-case-grid">
      <div class="work-case-copy">
        <ul class="fa-downloads">
          <li>
            <a href={RELEASES}>macOS, Apple silicon ↗</a>
            <span>The file ending <code>aarch64.dmg</code></span>
          </li>
          <li>
            <a href={RELEASES}>macOS, Intel ↗</a>
            <span>The file ending <code>x64.dmg</code></span>
          </li>
          <li>
            <a href={RELEASES}>Linux, x86_64 ↗</a>
            <span
              >The file ending <code>.AppImage</code>, or <code>.deb</code> on Debian
              and Ubuntu</span
            >
          </li>
        </ul>
        <p>
          Not sure which Mac you have? Open the Apple menu, choose About This
          Mac, and read the Chip or Processor line. Anything beginning with
          Apple is Apple silicon. Anything beginning with Intel is Intel.
        </p>
        <div class="inline-links">
          <a href="https://docs.fest.build">Install Camp and Fest first ↗</a>
          <a href="/festival-activity/terms">Terms of sale</a>
        </div>
      </div>

      <dl class="work-facts">
        <div>
          <dt>ACTIVATE</dt>
          <dd>Open the app and paste your key</dd>
        </div>
        <div>
          <dt>INSTALLS</dt>
          <dd>Two at a time</dd>
        </div>
        <div>
          <dt>OFFLINE</dt>
          <dd>90 days between checks</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<script define:vars={{ LICENSE_API }}>
  // The key is displayed and nothing else. It is never logged, never put in a
  // URL, and never sent anywhere. This page also carries no analytics, which is
  // set in the layout: see the analytics prop on Base.astro.
  const params = new URLSearchParams(window.location.search);
  const session = params.get("session_id");

  const working = document.getElementById("fa-working");
  const found = document.getElementById("fa-key");
  const fallback = document.getElementById("fa-fallback");
  const keyText = document.getElementById("fa-key-text");
  const licensee = document.getElementById("fa-licensee");
  const copy = document.getElementById("fa-copy");

  // How long to keep asking before telling the buyer the key is not ready.
  //
  // Ten minutes with exponential backoff from two seconds to thirty. The first
  // version polled every two seconds for a minute, thirty requests, against a
  // service that allows sixty a minute per session; that ran out twenty seconds
  // in on the version before this one and showed the buyer a message saying
  // their key had been emailed, which nothing does. The service's limit and
  // this schedule are pinned against each other by a test on the service side.
  const BUDGET_MS = 10 * 60 * 1000;
  const FIRST_WAIT_MS = 2000;
  const LONGEST_WAIT_MS = 30000;

  function show(panel) {
    for (const candidate of [working, found, fallback]) {
      candidate.hidden = candidate !== panel;
    }
  }

  function showKey(key, address) {
    keyText.textContent = key;
    if (address) {
      licensee.textContent = `Licensed to ${address}.`;
      licensee.hidden = false;
    }
    show(found);
  }

  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(keyText.textContent ?? "");
      copy.textContent = "Copied";
      setTimeout(() => {
        copy.textContent = "Copy key";
      }, 2000);
    } catch {
      // Some browsers refuse clipboard access, and an automated one always
      // does. That is not a failure worth an error message: select the key
      // instead, so the buyer's own copy shortcut takes it.
      selectKey();
      copy.textContent = "Key selected, press copy";
    }
  });

  function selectKey() {
    const selection = window.getSelection();
    if (!selection) return;
    const range = document.createRange();
    range.selectNodeContents(keyText);
    selection.removeAllRanges();
    selection.addRange(range);
  }

  // waitFor reads what the service asked for, in whichever form it sent it.
  // Retry-After is seconds by the HTTP specification; retry_after_ms is the
  // hint in our own body. Either is clamped, because a header is something a
  // proxy can also set.
  function waitFor(response, body, fallbackMs) {
    const header = Number(response.headers.get("Retry-After"));
    if (Number.isFinite(header) && header > 0) {
      return clampWait(header * 1000);
    }
    if (body && Number.isFinite(body.retry_after_ms)) {
      return clampWait(body.retry_after_ms);
    }
    return clampWait(fallbackMs);
  }

  function clampWait(ms) {
    return Math.min(Math.max(ms, 500), LONGEST_WAIT_MS);
  }

  async function readBody(response) {
    try {
      return await response.json();
    } catch {
      return null;
    }
  }

  async function poll() {
    const deadline = Date.now() + BUDGET_MS;
    const url = `${LICENSE_API.replace(/\/$/, "")}/v1/checkout/${encodeURIComponent(session)}/key`;
    let backoff = FIRST_WAIT_MS;

    while (Date.now() < deadline) {
      let response;
      try {
        response = await fetch(url, {
          headers: { Accept: "application/json" },
        });
      } catch {
        // Unreachable, blocked, or offline. Keep trying: a buyer who was on a
        // train when the page loaded should not be told their key is missing.
        await sleep(backoff);
        backoff = nextBackoff(backoff);
        continue;
      }

      if (response.status === 200) {
        const body = await readBody(response);
        if (body && body.key) {
          showKey(body.key, body.licensee);
          return;
        }
        show(fallback);
        return;
      }

      // 202 is the webhook not having landed. 429 is the service asking us to
      // slow down. Both mean wait, and treating either as terminal is what put
      // a buyer on a working deployment in front of the manual message.
      if (response.status === 202 || response.status === 429) {
        const body = await readBody(response);
        await sleep(waitFor(response, body, backoff));
        backoff = nextBackoff(backoff);
        continue;
      }

      // 404 after the delivery window, or anything else. A buyer cannot act on
      // the difference and the support path handles all of them.
      show(fallback);
      return;
    }
    // The budget ran out. Say that the key is not ready, not that it is on its
    // way to an inbox.
    show(fallback);
  }

  function nextBackoff(current) {
    return Math.min(current * 2, LONGEST_WAIT_MS);
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  if (!session || !LICENSE_API) {
    // No request at all. Under manual issuance this is every purchase.
    show(fallback);
  } else {
    poll();
  }
</script>

<style>
  .fa-thanks-hero h1 {
    max-width: none;
  }

  .fa-key-section {
    padding-top: 0;
  }

  .fa-panel {
    max-width: 46rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--panel);
    border: 1px solid var(--line-strong);
    box-shadow: 0.65rem 0.65rem 0 rgba(0, 229, 232, 0.04);
  }

  .fa-panel-lede {
    margin: 0.9rem 0 1rem;
    color: var(--ink);
    font-size: clamp(1.2rem, 1vw + 1rem, 1.6rem);
    line-height: 1.34;
    letter-spacing: -0.02em;
  }

  .fa-panel p:last-child {
    margin-bottom: 0;
  }

  .fa-key-value {
    margin: 1rem 0 1.4rem;
    overflow-wrap: anywhere;
  }

  .fa-key-value code {
    color: var(--accent);
    font-family: var(--mono);
    font-size: clamp(1.1rem, 2.5vw, 1.75rem);
    letter-spacing: 0.04em;
    user-select: all;
  }

  .fa-key-note {
    max-width: 48ch;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .fa-downloads {
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .fa-downloads li {
    padding: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .fa-downloads a {
    color: var(--ink);
    font-size: 1.02rem;
    text-decoration: none;
  }

  .fa-downloads a:hover {
    color: var(--accent);
  }

  .fa-downloads span {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .fa-downloads code {
    color: var(--body);
    font-family: var(--mono);
    font-size: 0.8rem;
  }
</style>
