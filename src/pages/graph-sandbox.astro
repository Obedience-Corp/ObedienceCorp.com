---
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignGraph from '../components/CampaignGraph.astro';
---

<BaseLayout
  title="Campaign graph (sandbox)"
  description="Isolated sandbox for the organized-diffusion campaign graph component."
>
  <section class="sandbox">
    <div class="sandbox-inner">
      <p class="mono-label sandbox-eyebrow">Organized diffusion</p>
      <h1 class="sandbox-h1">Every campaign, project, and decision has a place and a state.</h1>
      <p class="sandbox-lede">
        Like a diffusion model, but organized. Steer at the level of missions and the decisions that shaped them. Drill into the detail only when you need it.
      </p>

      <CampaignGraph />
    </div>
  </section>
</BaseLayout>

<style>
  .sandbox {
    min-height: 100vh;
  }
  .sandbox-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vh, 6rem) clamp(1.25rem, 3vw, 3.5rem);
  }
  .sandbox-eyebrow {
    display: block;
    margin-bottom: 1.1rem;
  }
  .sandbox-h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink-primary);
    margin: 0 0 1.1rem;
    max-width: 22ch;
  }
  .sandbox-lede {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 56ch;
    margin: 0 0 clamp(2.5rem, 5vh, 3.5rem);
  }
</style>
