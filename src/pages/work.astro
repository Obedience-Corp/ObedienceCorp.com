---
import Base from "../layouts/Base.astro";
import ExecutionTrace from "../components/visual/ExecutionTrace.astro";
import { getCollection } from "astro:content";

const festival = (await getCollection("work")).find(
  (entry) => entry.data.name === "Festival",
);

if (!festival) {
  throw new Error("Festival work entry is missing");
}
---

<Base
  title="Work — Obedience Corp"
  description="Forward deployed engagements, and Festival, the open-source system that runs them."
  current="/work"
>
  <section class="inner-hero inner-hero-split work-hero">
    <div>
      <p class="eyebrow">SELECTED WORK</p>
      <h1>Work you can inspect, run, and judge for yourself.</h1>
      <p>
        Obedience Corp builds in the open where it can, and under NDA where it
        can’t. Festival is public and runnable today; the client work is
        described without naming the companies.
      </p>
    </div>
    <ExecutionTrace title="PUBLIC ARTIFACT / FESTIVAL" compact />
  </section>

  <section class="work-case">
    <header class="work-case-head">
      <div>
        <p class="section-label">01 / OPEN SOURCE</p>
        <h2>{festival.data.name}</h2>
      </div>
      <p>{festival.data.license?.toUpperCase()} · AVAILABLE NOW</p>
    </header>

    <div class="work-case-grid">
      <div class="work-case-copy">
        <p class="work-case-lede">
          A durable workspace and workflow for serious work with AI agents.
        </p>
        <p>
          Festival keeps the goal, context, plan, decisions, and evidence in
          files that people and agents can both use. Work can cross sessions
          without becoming trapped in chat history or dependent on one model.
        </p>
        <p>
          The project includes the <code>camp</code> and <code>fest</code>{" "}
          command-line tools and works alongside shell-capable agents such as
          Claude Code and Codex.
        </p>
        <div class="inline-links">
          <a href={festival.data.url}>Product site ↗</a>
          <a href="https://docs.fest.build">Documentation ↗</a>
          <a href="https://github.com/Obedience-Corp/festival">Source ↗</a>
        </div>
      </div>

      <dl class="work-facts">
        <div>
          <dt>STATUS</dt>
          <dd>Public</dd>
        </div>
        <div>
          <dt>LICENSE</dt>
          <dd>{festival.data.license}</dd>
        </div>
        <div>
          <dt>SURFACE</dt>
          <dd>Command line</dd>
        </div>
        <div>
          <dt>FOCUS</dt>
          <dd>Context, planning, execution, verification</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="work-case client-work">
    <header class="work-case-head">
      <div>
        <p class="section-label">02 / CLIENT WORK</p>
        <h2>Under NDA</h2>
      </div>
      <p>2025 · NAMES WITHHELD</p>
    </header>

    <div class="work-case-grid">
      <div class="work-case-copy">
        <p class="work-case-lede">
          Three startups launched products built with these systems.
        </p>
        <p>
          The engagements are covered by agreements that do not allow us to
          name the companies or show the code, so we describe the shape of the
          work instead. In each case the same system carried it: a defined
          scope, context kept in files the client owns, execution across many
          sessions, and verification before anything shipped.
        </p>
        <p>
          If a reference matters before you commit, ask on a call. What we can
          share, we share directly. Festival above is the part you can
          audit line by line without asking anyone’s permission.
        </p>
      </div>

      <dl class="work-facts">
        <div>
          <dt>ENGAGEMENTS</dt>
          <dd>3 startups, 2025</dd>
        </div>
        <div>
          <dt>OUTCOME</dt>
          <dd>Products launched</dd>
        </div>
        <div>
          <dt>DISCLOSURE</dt>
          <dd>Names and code under NDA</dd>
        </div>
        <div>
          <dt>SAME SYSTEM</dt>
          <dd>Scope, context, execution, verification</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="work-proof">
    <p class="section-label">WHAT IT PROVES</p>
    <div>
      <h2>Not a concept site. A working system built under load.</h2>
      <p>
        Festival grew out of using AI agents every day across software,
        research, and company operations. The code, documentation, and ongoing
        field notes are public so the work can be evaluated on substance.
      </p>
      <a href="/blog/nine-months-of-festival">Read the nine-month field report →</a>
    </div>
  </section>

  <section class="work-cta">
    <p class="section-label">APPLIED ENGAGEMENTS</p>
    <h2>Need this kind of reliability inside your own AI workflow?</h2>
    <a class="action action-primary" href="/#engagements">See how an engagement works →</a>
  </section>
</Base>
