---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import Engagements from "../components/home/Engagements.astro";
import FestivalFeature from "../components/home/FestivalFeature.astro";
import FounderIntro from "../components/home/FounderIntro.astro";
import HomeHero from "../components/home/HomeHero.astro";
import OperatingGap from "../components/home/OperatingGap.astro";
import WritingPreview from "../components/home/WritingPreview.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="Obedience Corp — Forward Deployed Engineering"
  description="Forward deployed engineering for teams with work that needs removing."
  landing
>
  <HomeHero />
  <OperatingGap />
  <Engagements />
  <FestivalFeature />
  <ContactForm />
  <WritingPreview posts={posts} />
  <FounderIntro />
</Base>
