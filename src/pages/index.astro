<script>
  // Founder's note modal — open/close wiring for the native <dialog>.
  const founderDialog = document.getElementById('founder-note') as HTMLDialogElement | null;
  const founderOpen = document.getElementById('founder-note-open');
  const founderClose = document.getElementById('founder-note-close');

  founderOpen?.addEventListener('click', () => founderDialog?.showModal());
  founderClose?.addEventListener('click', () => founderDialog?.close());

  // Click outside the content panel (i.e. on the backdrop) closes the dialog.
  founderDialog?.addEventListener('click', (e) => {
    if (e.target === founderDialog) founderDialog.close();
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (status) {
        if (res.ok) {
          status.textContent = "Message sent. We'll be in touch.";
          status.dataset.state = 'ok';
          form.reset();
        } else {
          status.textContent = 'Something went wrong. Please try again.';
          status.dataset.state = 'err';
        }
      }
    } catch {
      if (status) {
        status.textContent = 'Network error. Please try again.';
        status.dataset.state = 'err';
      }
    }
  });
</script>
