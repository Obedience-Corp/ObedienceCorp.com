---
import Base from "../layouts/Base.astro";
import BitmapText from "../components/BitmapText.astro";
---

<Base
  title="404 — Obedience Corp"
  description="This page does not exist. Agents that obey."
>
  <section class="lost-stage" aria-label="Page not found">
    <canvas id="rain" aria-hidden="true"></canvas>
    <div class="lost-lockup">
      <div class="lost-code"><BitmapText text="404" scale={16} fit /></div>
      <div class="lost-line">
        <BitmapText text="AGENTS THAT OBEY" scale={4} fit />
      </div>
      <p class="lost-note">
        This page does not exist.
        <a href="/">RETURN TO BASE →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .lost-stage {
    position: relative;
    min-height: calc(100vh - 8rem);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #000;
  }

  #rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lost-lockup {
    position: relative;
    z-index: 1;
    background: radial-gradient(
      closest-side,
      rgba(0, 0, 0, 0.96) 62%,
      rgba(0, 0, 0, 0) 100%
    );
    padding: 4rem clamp(2rem, 8vw, 7rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    text-align: center;
    color: #f4f4f4;
  }

  .lost-code {
    width: min(21rem, 62vw);
  }

  .lost-line {
    width: min(30rem, 86vw);
    color: #8a8a8a;
  }

  .lost-note {
    margin: 0.5rem 0 0;
    color: var(--muted, #8a8a8a);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .lost-note a {
    margin-left: 0.8rem;
    color: var(--accent, #f4f4f4);
    text-decoration: none;
  }

  .lost-note a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { startRain } from "../lib/rain";

  const canvas = document.getElementById("rain");
  if (canvas instanceof HTMLCanvasElement) {
    startRain(canvas);
  }
</script>
