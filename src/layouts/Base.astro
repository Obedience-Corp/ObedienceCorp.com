---
import Chrome from "../components/Chrome.astro";
import DocumentHead from "../components/DocumentHead.astro";
import LocalPreview from "../components/LocalPreview.astro";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  current?: string;
  landing?: boolean;
  image?: string;
  // analytics is on everywhere except one page. The Festival Activity success
  // page carries a customer's license key in its DOM, so it gets no analytics,
  // no session recorder, and no third party script of any kind. Anything added
  // to the head below has to respect this flag, or that key ends up in a
  // vendor's logs.
  analytics?: boolean;
  // noindex keeps a page out of search results and out of the sitemap. The same
  // success page carries a checkout session id in its URL, which is a bearer
  // credential on the key lookup for 24 hours, so a crawler has no business on
  // it. The sitemap filter in astro.config.mjs excludes the same route.
  noindex?: boolean;
}

const {
  title,
  description,
  current,
  landing = false,
  image,
  analytics = true,
  noindex = false,
} = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head
    ><DocumentHead {title} {description} {image} {analytics} {noindex} /></head
  >
  <body class={landing ? "is-landing" : undefined}>
    {import.meta.env.DEV && <LocalPreview />}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Chrome current={current} />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src="/brand/logo.svg" width="32" height="32" alt="" />
          <div>
            <strong>OBEDIENCE CORP</strong>
            <p>
              Forward deployed engineering. We embed with your team and remove
              the work that is eating it.
            </p>
          </div>
        </div>
        <div class="footer-column">
          <h2>EXPLORE</h2>
          <ul>
            <li><a href="/work">Work</a></li>
            <li><a href="/blog">Writing</a></li>
            <li><a href="/thesis">Thesis</a></li>
            <li><a href="https://fest.build">Festival ↗</a></li>
          </ul>
        </div>
        <div class="footer-column">
          <h2>CONNECT</h2>
          <ul>
            <li><a href="/#contact">Contact form</a></li>
            <li><a href="https://github.com/Obedience-Corp">GitHub ↗</a></li>
            <li><a href="https://x.com/ObedienceCorp">X ↗</a></li>
            <li>
              <a href="https://www.linkedin.com/in/lancekrogers">LinkedIn ↗</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} OBEDIENCE CORP</span>
        <span>OBEDIENCECORP.COM</span>
      </div>
    </footer>
  </body>
</html>
