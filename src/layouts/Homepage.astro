---
import DocumentHead from "../components/DocumentHead.astro";
import LocalPreview from "../components/LocalPreview.astro";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/homepage.css";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head><DocumentHead {title} {description} themeColor="#080a0a" /></head>
  <body class="home-page">
    {import.meta.env.DEV && <LocalPreview />}
    <a class="home-skip" href="#main-content">Skip to content</a>
    <header class="home-chrome wrap">
      <a class="home-wordmark" href="/" aria-label="Obedience Corp home">
        <img src="/brand/logo.svg" width="32" height="32" alt="" />
        <span>OBEDIENCE CORP</span>
      </a>
      <nav aria-label="Primary">
        <>
          <a href="/work/">Work</a>
          <a href="/blog/">Writing</a>
          <a
            href="/releases/"
            aria-current={Astro.url.pathname.startsWith("/releases/")
              ? "page"
              : undefined}>Releases</a
          >
          <a href="/thesis/">Thesis</a>
          <a href="/about/">About</a>
        </>
        <a class="nav-contact" href="/#contact">
          Contact <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="home-footer wrap">
      <div class="footer-identity">
        <img src="/brand/logo.svg" width="28" height="28" alt="" />
        <p>OBEDIENCE CORP</p>
        <span>Forward deployed engineering.</span>
      </div>
      <nav aria-label="Company and products">
        <a href="/work/">Work</a><a href="/blog/">Writing</a><a
          href="/releases/">Releases</a
        ><a href="/releases/feed.xml">Release RSS</a>
        <a href="/about/">About</a><a href="/thesis/">Thesis</a>
        <a href="https://fest.build">Festival ↗</a><a href="/festival-activity/"
          >Festival Activity</a
        >
      </nav>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} Obedience Corp</span><a
          href="https://github.com/Obedience-Corp">GitHub ↗</a
        ><a href="https://x.com/ObedienceCorp">X ↗</a><a
          href="https://www.linkedin.com/in/lancekrogers">LinkedIn ↗</a
        >
      </div>
    </footer>
  </body>
</html>
