---
// Top navigation — persistent across both pages.
// Wordmark links to /. Thesis and Contact are anchors on / (#thesis, #contact);
// they work both within the home page and as cross-page anchors from /work.
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a href="/" class="wordmark" aria-label="Obedience Corp, home">Obedience Corp</a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        <li><a href="/#thesis">Thesis</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-rule);
  }

  .site-nav-inner {
    width: 100%;
    padding: 1.25rem clamp(1.25rem, 3vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wordmark {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.005em;
    color: var(--color-ink-primary);
  }

  .wordmark:hover {
    color: var(--color-ink-primary);
    opacity: 0.7;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .nav-list a:hover {
    color: var(--color-ink-primary);
  }

  @media (max-width: 640px) {
    .site-nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
    .nav-list {
      gap: 1.25rem;
    }
  }
</style>
