  const UNIT = 184;     // px per time tick
  const PAD_L = 296;    // left padding so first nodes clear the sticky labels
  const PAD_R = 140;
  const BAND_H = 168;
  const AXIS_H = 46;
  const TRACK_Y = 74;   // band-track / marker centerline within a band
  const FEAT_Y = 128;   // work track offset within a band

  const MOTES: Array<[number, number]> = [
    [0.15, 0.22], [0.28, 0.74], [0.42, 0.4], [0.55, 0.18], [0.6, 0.66],
    [0.7, 0.85], [0.82, 0.3], [0.9, 0.55], [1.1, 0.12], [1.18, 0.78],
    [1.32, 0.46], [1.5, 0.7], [1.62, 0.25], [1.8, 0.9], [1.95, 0.5],
    [2.1, 0.34], [2.25, 0.66], [2.5, 0.2], [2.7, 0.82], [2.9, 0.48],
    [3.1, 0.6], [3.4, 0.28], [3.7, 0.74], [4.0, 0.42], [4.4, 0.66],
    [4.9, 0.3], [5.4, 0.55], [5.9, 0.4],
  ];

  function resolution(t: number, maxT: number): number {
    const lin = Math.max(0, Math.min(1, t / maxT));
    return lin * lin;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function initGraph(root: HTMLElement) {
    const rail = root.querySelector<HTMLElement>(".cg-rail");
    const viewing = root.querySelector<HTMLElement>(".cg-viewing");
    const scroll = root.querySelector<HTMLElement>(".cg-scroll");
    const canvas = root.querySelector<HTMLElement>(".cg-canvas");
    const grid = root.querySelector<HTMLElement>(".cg-grid");
    const field = root.querySelector<SVGSVGElement>(".cg-field");
    const svg = root.querySelector<SVGSVGElement>(".cg-edges");
    const bands = root.querySelector<HTMLElement>(".cg-bands");
    const axis = root.querySelector<HTMLElement>(".cg-axis");
    if (!rail || !viewing || !scroll || !canvas || !grid || !field || !svg || !bands || !axis) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const maxT = TICKS.length - 1;
    const xOf = (t: number) => PAD_L + t * UNIT;
    const width = xOf(maxT) + PAD_R;

    for (const s of [field, svg]) {
      s.setAttribute("viewBox", `0 0 ${width} ${BAND_H}`);
      s.setAttribute("width", String(width));
    }
    canvas.style.width = `${width}px`;

    // Per-render observer + inspector state (managed across campaign switches).
    let io: IntersectionObserver | null = null;
    let motesIo: IntersectionObserver | null = null;
    let inspector: HTMLElement | null = null;
    let openBtn: HTMLButtonElement | null = null;
    let renderHeight = BAND_H + AXIS_H;

    function closeInspector() {
      if (!openBtn || !inspector) return;
      inspector.classList.remove("is-open", "is-flip");
      inspector.setAttribute("aria-hidden", "true");
      openBtn.setAttribute("aria-expanded", "false");
      openBtn.classList.remove("is-open");
      openBtn = null;
    }

    // One-time interaction wiring (survives re-renders).
    scroll.addEventListener("click", () => closeInspector());
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && openBtn) {
        const btn = openBtn;
        closeInspector();
        btn.focus();
      }
    });

    function renderCampaign(camp: CGCampaign) {
      // Tear down previous render.
      io?.disconnect();
      motesIo?.disconnect();
      io = null;
      motesIo = null;
      openBtn = null;
      grid.innerHTML = "";
      field.innerHTML = "";
      svg.innerHTML = "";
      bands.innerHTML = "";
      axis.innerHTML = "";
      // Decision markers, work pills, and the inspector are direct children of
      // the canvas (not of bands/grid/etc.), so clear them explicitly or they
      // leak across campaign switches.
      canvas.querySelectorAll(".cg-node, .cg-inspector").forEach((n) => n.remove());

      const projects = camp.projects;
      const bandsBottom = projects.length * BAND_H;
      renderHeight = bandsBottom + AXIS_H;
      canvas.style.setProperty("--cg-h", `${renderHeight}px`);
      for (const s of [field, svg]) {
        s.setAttribute("viewBox", `0 0 ${width} ${renderHeight}`);
        s.setAttribute("height", String(renderHeight));
      }

      const decPos: Record<string, { x: number; y: number }> = {};
      const workPos: Record<string, { x: number; y: number; state: CGState }> = {};
      const decById: Record<string, CGDecision> = {};

      // Gridlines.
      TICKS.forEach((_, i) => {
        const gl = document.createElement("div");
        gl.className = "cg-gridline";
        gl.style.left = `${xOf(i)}px`;
        grid.appendChild(gl);
      });

      // Diffuse scatter field.
      let motes = "";
      for (const [t, frac] of MOTES) {
        const x = xOf(t);
        const y = 24 + frac * (bandsBottom - 48);
        const res = resolution(t, maxT);
        const r = (2.8 - res * 1.7).toFixed(2);
        const o = (0.2 - res * 0.13).toFixed(3);
        motes += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r}" style="--mote-o:${o}" data-mote />`;
      }
      field.innerHTML = motes;

      // Project bands + decision markers + work nodes.
      projects.forEach((proj, li) => {
        const bandTop = li * BAND_H;
        const band = document.createElement("div");
        band.className = "cg-band" + (li === 0 ? " is-first" : "");
        band.style.top = `${bandTop}px`;
        band.style.setProperty("--band-h", `${BAND_H}px`);
        band.style.setProperty("--track-y", `${TRACK_Y}px`);

        const lastT = proj.events.reduce((m, ev) => {
          const ft = ev.ft ?? ev.dt;
          return Math.max(m, ev.dt, ft);
        }, proj.start);
        const spanX1 = xOf(proj.start);
        const spanX2 = xOf(lastT);

        const doneMax = proj.events
          .filter((e) => e.state === "done")
          .reduce((m, e) => Math.max(m, e.ft ?? e.dt), proj.start);
        const denom = lastT - proj.start || 1;
        const doneFrac = Math.max(0, Math.min(1, (doneMax - proj.start) / denom)) * 100;

        const track = document.createElement("div");
        track.className = "cg-band-track";
        track.style.left = `${spanX1}px`;
        track.style.width = `${spanX2 - spanX1}px`;
        track.style.setProperty("--done-frac", `${doneFrac.toFixed(0)}%`);
        track.dataset.reveal = "track";
        band.appendChild(track);

        const label = document.createElement("div");
        label.className = "cg-band-label";
        label.innerHTML =
          `<span class="cg-band-kind">Project</span>` +
          `<span class="cg-band-name">${escapeHtml(proj.name)}</span>` +
          `<span class="cg-band-role">${escapeHtml(proj.role)}</span>` +
          `<span class="cg-band-span">${TICKS[proj.start]} – ${TICKS[lastT]}</span>`;
        band.appendChild(label);

        bands.appendChild(band);

        proj.events.forEach((ev) => {
          decById[ev.id] = ev;
          const res = resolution(ev.dt, maxT);
          const nodeO = (0.72 + res * 0.28).toFixed(3);
          const scl = (0.94 + res * 0.06).toFixed(3);

          const decX = xOf(ev.dt);
          const decY = bandTop + TRACK_Y + 3;
          decPos[ev.id] = { x: decX, y: decY };

          const dec = document.createElement("button");
          dec.type = "button";
          dec.className = "cg-node cg-decision";
          dec.style.left = `${decX}px`;
          dec.style.top = `${decY}px`;
          dec.style.setProperty("--no", nodeO);
          dec.style.setProperty("--scl", scl);
          dec.dataset.reveal = "node";
          dec.dataset.decId = ev.id;
          dec.setAttribute("aria-haspopup", "dialog");
          dec.setAttribute("aria-expanded", "false");
          dec.setAttribute(
            "aria-label",
            `Decision, ${TICKS[ev.dt]}: ${ev.decision}. ${ev.state}. Activate to inspect the ${ev.plan.length} items it expands into.`
          );
          dec.innerHTML =
            `<span class="cg-marker is-${ev.state}"></span>` +
            `<span class="cg-dec-caption">` +
            `<span class="cg-dec-when">Decision · ${TICKS[ev.dt]}</span>` +
            `${escapeHtml(ev.decision)}` +
            `<span class="cg-dec-drill" aria-hidden="true">${ev.plan.length} items ↳</span>` +
            `</span>`;
          canvas.appendChild(dec);

          if (ev.work && ev.ft !== undefined) {
            const fRes = resolution(ev.ft, maxT);
            const featX = xOf(ev.ft);
            const featY = bandTop + FEAT_Y;
            workPos[ev.id] = { x: featX, y: featY, state: ev.state };

            const feat = document.createElement("div");
            feat.className = "cg-node cg-feature";
            feat.style.left = `${featX}px`;
            feat.style.top = `${featY}px`;
            feat.style.setProperty("--no", (0.72 + fRes * 0.28).toFixed(3));
            feat.style.setProperty("--scl", (0.94 + fRes * 0.06).toFixed(3));
            feat.style.setProperty("--border-c", `${(50 + fRes * 50).toFixed(0)}%`);
            feat.dataset.reveal = "node";
            feat.dataset.edge = `f-${ev.id}`;
            feat.innerHTML = `<i class="cg-dot is-${ev.state}"></i>${escapeHtml(ev.work)}`;
            canvas.appendChild(feat);
          }
        });
      });

      // Edges.
      let edges =
        `<defs><marker id="cg-arrow" viewBox="0 0 10 10" refX="8" refY="5" ` +
        `markerWidth="6" markerHeight="6" orient="auto-start-reverse">` +
        `<path class="cg-arrow-fill" d="M0 0 L10 5 L0 10 z" /></marker></defs>`;

      // Intra-project: decision -> its own work.
      projects.forEach((proj) => {
        proj.events.forEach((ev) => {
          if (!(ev.work && ev.ft !== undefined)) return;
          const d = decPos[ev.id];
          const f = workPos[ev.id];
          if (!d || !f) return;
          const fRes = resolution(ev.ft, maxT);
          const edgeO = (0.32 + fRes * 0.36).toFixed(3);
          const x1 = d.x, y1 = d.y + 10;
          const x2 = f.x, y2 = f.y - 12;
          const my = (y1 + y2) / 2;
          edges += `<path class="cg-edge" data-edge="f-${ev.id}" style="--edge-o:${edgeO}" ` +
            `d="M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}" />`;
        });
      });

      // Cross-project threads (within this campaign).
      camp.links.forEach((lnk, i) => {
        const src = decPos[lnk.from];
        const dst = workPos[lnk.to] || decPos[lnk.to];
        if (!src || !dst) return;
        const x1 = src.x, y1 = src.y;
        const x2 = dst.x, y2 = dst.y;
        const down = y2 > y1;
        const cx1 = x1 + (x2 - x1) * 0.2;
        const cy1 = y1 + (down ? 50 : -50);
        const cx2 = x2 - (x2 - x1) * 0.2;
        const cy2 = y2 + (down ? -50 : 50);
        const triggerEdge = workPos[lnk.to] ? `f-${lnk.to}` : `node-${lnk.to}`;
        edges += `<path class="cg-thread" data-thread="t-${i}" data-thread-trigger="${triggerEdge}" ` +
          `d="M ${x1} ${y1} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${x2} ${y2}" />`;
      });

      svg.innerHTML = edges;

      // Axis.
      const axisLine = document.createElement("div");
      axisLine.className = "cg-axisline";
      axis.appendChild(axisLine);
      TICKS.forEach((t, i) => {
        const tick = document.createElement("div");
        tick.className = "cg-tick";
        tick.style.left = `${xOf(i)}px`;
        tick.textContent = t;
        axis.appendChild(tick);
      });

      // Inspector.
      inspector = document.createElement("div");
      inspector.className = "cg-inspector";
      inspector.setAttribute("role", "dialog");
      inspector.setAttribute("aria-label", "Decision detail");
      inspector.setAttribute("aria-hidden", "true");
      canvas.appendChild(inspector);

      function openInspector(btn: HTMLButtonElement) {
        const ev = decById[btn.dataset.decId || ""];
        if (!ev || !inspector) return;
        if (openBtn === btn) { closeInspector(); return; }
        closeInspector();

        const stateLabel = ev.state === "done" ? "Resolved" : ev.state === "active" ? "In progress" : "Queued";
        const items = ev.plan
          .map(
            (p) =>
              `<li class="cg-insp-item"><span class="cg-insp-tag">${escapeHtml(p.tag)}</span><span>${escapeHtml(p.text)}</span></li>`
          )
          .join("");
        inspector.innerHTML =
          `<div class="cg-insp-kind">Decision · ${TICKS[ev.dt]} · ${stateLabel}</div>` +
          `<p class="cg-insp-title">${escapeHtml(ev.decision)}</p>` +
          (ev.work
            ? `<p class="cg-insp-sub">Expands into ${ev.plan.length} linked items · produced “${escapeHtml(ev.work)}”</p>`
            : `<p class="cg-insp-sub">Expands into ${ev.plan.length} linked items</p>`) +
          `<ul class="cg-insp-list">${items}</ul>` +
          `<div class="cg-insp-foot">Illustrative — a model, not live data</div>`;

        const left = parseFloat(btn.style.left);
        const top = parseFloat(btn.style.top);
        const half = (17 * 16) / 2;
        const clampedLeft = Math.max(half + 8, Math.min(width - half - 8, left));
        inspector.style.left = `${clampedLeft}px`;

        inspector.classList.add("is-open");
        inspector.setAttribute("aria-hidden", "false");
        const estH = inspector.offsetHeight || 180;
        if (top + 18 + estH > renderHeight - 6) {
          inspector.classList.add("is-flip");
          inspector.style.top = `${Math.max(6, top - estH - 16)}px`;
        } else {
          inspector.style.top = `${top + 18}px`;
        }

        btn.setAttribute("aria-expanded", "true");
        btn.classList.add("is-open");
        openBtn = btn;
      }

      inspector.addEventListener("click", (e) => e.stopPropagation());
      canvas.querySelectorAll<HTMLButtonElement>(".cg-decision").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          openInspector(btn);
        });
      });

      // Reveal-on-scroll.
      const revealEdge = (edgeId: string) => {
        const path = svg.querySelector<SVGPathElement>(`path[data-edge="${edgeId}"]`);
        if (!path) return;
        const len = path.getTotalLength();
        path.style.strokeDasharray = String(len);
        path.style.strokeDashoffset = String(len);
        requestAnimationFrame(() => path.classList.add("is-in"));
      };
      const revealThreadsFor = (triggerEdge: string) => {
        svg.querySelectorAll<SVGPathElement>(`path[data-thread-trigger="${triggerEdge}"]`).forEach((path) => {
          requestAnimationFrame(() => path.classList.add("is-in"));
        });
      };

      if (reduceMotion) {
        canvas.querySelectorAll<HTMLElement>("[data-reveal]").forEach((n) => n.classList.add("is-in"));
        field.querySelectorAll<SVGElement>("[data-mote]").forEach((m) => m.classList.add("is-in"));
        svg.querySelectorAll<SVGPathElement>("path.cg-edge").forEach((p) => p.classList.add("is-in"));
        svg.querySelectorAll<SVGPathElement>("path.cg-thread").forEach((p) => p.classList.add("is-in"));
        return;
      }

      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.classList.add("is-in");
            const edgeId = el.dataset.edge;
            if (edgeId) {
              revealEdge(edgeId);
              revealThreadsFor(edgeId);
            }
            if (el.dataset.decId) revealThreadsFor(`node-${el.dataset.decId}`);
            io?.unobserve(el);
          });
        },
        { root: scroll, threshold: 0.18, rootMargin: "0px -6% 0px -6%" }
      );
      canvas.querySelectorAll<HTMLElement>("[data-reveal]").forEach((n) => io!.observe(n));

      motesIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("is-in");
            motesIo?.unobserve(e.target);
          });
        },
        { root: scroll, threshold: 0.05 }
      );
      field.querySelectorAll<SVGElement>("[data-mote]").forEach((m) => motesIo!.observe(m));
    }

    // ── Build the campaign rail (once) ──
    let activeIdx = -1;
    const railLabel = document.createElement("span");
    railLabel.className = "cg-rail-label";
    railLabel.textContent = "Campaigns";
    rail.appendChild(railLabel);

    const chips: HTMLButtonElement[] = [];
    CAMPAIGNS.forEach((camp, i) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "cg-chip";
      chip.setAttribute("role", "tab");
      chip.textContent = camp.name;
      chip.addEventListener("click", () => select(i));
      rail.appendChild(chip);
      chips.push(chip);
    });
    const more = document.createElement("span");
    more.className = "cg-rail-more";
    more.textContent = `+${MORE_CAMPAIGNS} more · ${CAMPAIGNS.length + MORE_CAMPAIGNS} total`;
    rail.appendChild(more);

    function select(i: number) {
      if (i === activeIdx) return;
      activeIdx = i;
      const camp = CAMPAIGNS[i];
      chips.forEach((c, j) => {
        c.classList.toggle("is-active", j === i);
        c.setAttribute("aria-selected", j === i ? "true" : "false");
      });
      viewing.innerHTML =
        `<span class="cg-viewing-kind">Campaign</span>` +
        `<span class="cg-viewing-name">${escapeHtml(camp.name)}</span>` +
        `<span class="cg-viewing-stat">${escapeHtml(camp.kind)} · ${escapeHtml(camp.stat)}</span>`;
      closeInspector();
      renderCampaign(camp);
      scroll.scrollLeft = 0;
    }

    select(0);
  }

  document.querySelectorAll<HTMLElement>("[data-cg]").forEach(initGraph);
</script>
