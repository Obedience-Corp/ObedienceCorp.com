---
/**
 * CampaignGraph — illustrative model of the organized-diffusion system.
 *
 * CORRECT MODEL (matches how Festival is actually used):
 *   - A CAMPAIGN is a company / product / effort. You run many of them
 *     (this user runs ~19). The rail at the top is your campaigns.
 *   - INSIDE one campaign live its PROJECTS (repos), the decisions that shaped
 *     them over time, and the work each decision produced — which expands into
 *     festivals, intents, and design docs.
 *
 * The graph shows ONE selected campaign expanded: lanes = its projects, decision
 * markers sit on the timeline at their moment, the work each produced branches
 * below, and cross-project threads show a decision in one project unblocking
 * work in another (within the same campaign). Pick a different campaign in the
 * rail to switch the view. The point of the visual: this much organized work
 * fits inside ONE campaign, and you steer many at once.
 *
 * "Organized diffusion" is literal: the early/left of a campaign reads diffuse
 * (a thinning scatter field, softer nodes) and resolves into crisp, aligned
 * structure on the right. Decision markers are never jittered — a decision
 * always sits precisely on its timestamp; only the backdrop carries the scatter.
 *
 * Click (or Enter/Space on) any decision to drill into what it expands into.
 *
 * Self-contained: one .astro file, no external libraries, vanilla TS. Nodes are
 * created at runtime, so all CSS lives in <style is:global> with cg-* prefixes
 * (collision-safe; state classes are compound-scoped, never bare). Colors derive
 * ONLY from design tokens, so it is correct in both light and dark mode.
 *
 * Data is ILLUSTRATIVE and public-safe (a model, not live data).
 */
---

<div class="cg" data-cg>
  <div class="cg-rail" role="tablist" aria-label="Your campaigns"></div>
  <div class="cg-viewing"></div>
  <div
    class="cg-scroll"
    tabindex="0"
    role="group"
    aria-label="Campaign detail — the selected campaign's projects across time. Scroll horizontally to move through time; activate a decision marker to inspect what it expands into."
  >
    <div class="cg-canvas">
      <div class="cg-grid" aria-hidden="true"></div>
      <svg class="cg-field" aria-hidden="true"></svg>
      <svg class="cg-edges" aria-hidden="true"></svg>
      <div class="cg-bands"></div>
      <div class="cg-axis" aria-hidden="true"></div>
    </div>
  </div>
  <p class="cg-legend">
    <span class="cg-key"><i class="cg-dot is-done"></i> resolved</span>
    <span class="cg-key"><i class="cg-dot is-active"></i> in&nbsp;progress</span>
    <span class="cg-key"><i class="cg-dot is-queued"></i> queued</span>
    <span class="cg-key cg-key-thread"><i class="cg-thread-swatch"></i> cross&#8209;project&nbsp;link</span>
    <span class="cg-hint">Diffuse → organized. Scroll right through time →</span>
  </p>
</div>

<style is:global>
  /* Global (not scoped): runtime-created nodes do not receive Astro's scoping
     attribute. Every selector is cg-* prefixed to stay collision-safe; state
     classes (.is-done etc.) are always compound-scoped under .cg-*. */
  .cg {
    font-family: var(--font-sans);
    color: var(--color-ink-body);
  }

  /* ---- campaign rail (the portfolio: each chip is a company/product) ---- */
  .cg-rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cg-rail-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-right: 0.25rem;
  }
  .cg-chip {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: transparent;
    color: var(--color-ink-body);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .cg-chip:hover { border-color: var(--color-accent); }
  .cg-chip:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .cg-chip.is-active {
    background: var(--color-ink-primary);
    color: var(--color-bg-primary);
    border-color: var(--color-ink-primary);
  }
  .cg-rail-more {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    padding: 0.4rem 0.1rem;
    white-space: nowrap;
  }

  /* ---- "now viewing" line: campaign name + what it holds ---- */
  .cg-viewing {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.9rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .cg-viewing-kind {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .cg-viewing-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--color-ink-primary);
  }
  .cg-viewing-stat {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
  }

  .cg-scroll {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.5rem;
    outline: none;
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink-muted) transparent;
    scroll-behavior: smooth;
  }
  .cg-scroll:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .cg-canvas {
    position: relative;
    height: var(--cg-h, 600px);
    min-width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--color-bg-elevated) 0%, transparent) 30%,
      color-mix(in srgb, var(--color-bg-elevated) 45%, transparent) 100%
    );
    transition: height 220ms ease;
  }

  .cg-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .cg-gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-rule);
    opacity: 0.45;
  }

  .cg-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }
  .cg-field circle {
    fill: var(--color-ink-muted);
    opacity: 0;
    transition: opacity 700ms ease;
  }
  .cg-field circle.is-in { opacity: var(--mote-o, 0.16); }

  .cg-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 1;
  }
  .cg-edges path.cg-edge {
    fill: none;
    stroke: var(--color-ink-muted);
    stroke-width: 1.25;
    opacity: 0;
    transition: opacity 500ms ease, stroke-dashoffset 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cg-edges path.cg-edge.is-in {
    opacity: var(--edge-o, 0.5);
    stroke-dashoffset: 0;
  }
  .cg-edges path.cg-thread {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
    opacity: 0;
    marker-end: url(#cg-arrow);
    transition: opacity 600ms ease;
  }
  .cg-edges path.cg-thread.is-in { opacity: 0.7; }
  .cg-edges .cg-arrow-fill { fill: var(--color-accent); }

  /* Project band: the Gantt bar spanning a project's active range. */
  .cg-band {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--band-h, 168px);
    z-index: 1;
  }
  .cg-band-track {
    position: absolute;
    top: var(--track-y, 74px);
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink-muted) 26%, transparent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }
  .cg-band-track.is-in { transform: scaleX(1); }
  .cg-band-track::after {
    content: "";
    position: absolute;
    inset: 0;
    width: var(--done-frac, 0%);
    background: color-mix(in srgb, var(--color-ink-primary) 52%, transparent);
  }
  .cg-band::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-rule);
  }
  .cg-band.is-first::before { display: none; }

  .cg-band-label {
    position: sticky;
    left: 0;
    z-index: 4;
    display: inline-flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.7rem 0.95rem;
    margin: 0.85rem 0 0 0;
    background: color-mix(in srgb, var(--color-bg-primary) 97%, transparent);
    backdrop-filter: blur(6px);
    border-right: 1px solid var(--color-rule);
    box-shadow: 10px 0 16px -10px var(--color-bg-primary);
    width: max-content;
    max-width: 14.5rem;
  }
  .cg-band-kind {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .cg-band-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-primary);
    line-height: 1.12;
  }
  .cg-band-role {
    font-size: 0.72rem;
    color: var(--color-ink-muted);
    line-height: 1.25;
  }
  .cg-band-span {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    margin-top: 0.15rem;
    opacity: 0.85;
  }

  .cg-node {
    position: absolute;
    z-index: 3;
    opacity: 0;
    transition: opacity 440ms ease, transform 440ms cubic-bezier(0.22, 1, 0.36, 1);
    text-align: left;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    color: var(--color-ink-body);
  }

  .cg-decision {
    transform: translate(-50%, -50%) translateY(8px) scale(var(--scl, 1));
    cursor: pointer;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
  }
  .cg-decision.is-in {
    opacity: var(--no, 1);
    transform: translate(-50%, -50%) scale(var(--scl, 1));
  }
  .cg-marker {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-bg-primary);
    border: 1.5px solid var(--color-ink-primary);
    box-sizing: border-box;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }
  .cg-marker.is-active {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink-primary) 16%, transparent);
  }
  .cg-marker.is-queued {
    border-style: dashed;
    border-color: var(--color-ink-muted);
  }
  .cg-marker.is-done {
    background: var(--color-ink-primary);
  }
  .cg-decision:hover .cg-marker,
  .cg-decision:focus-visible .cg-marker {
    transform: scale(1.18);
  }
  .cg-decision:focus-visible { outline: none; }
  .cg-decision:focus-visible .cg-marker {
    box-shadow: 0 0 0 3px var(--color-accent);
  }
  .cg-decision.is-open .cg-marker {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  .cg-dec-caption {
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: 50%;
    transform: translateX(-50%);
    width: 9.6rem;
    text-align: center;
    font-size: 0.7rem;
    line-height: 1.22;
    color: var(--color-ink-body);
    pointer-events: none;
  }
  .cg-dec-when {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.12rem;
  }
  .cg-dec-drill {
    display: block;
    margin-top: 0.12rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    opacity: 0.85;
  }

  .cg-feature {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    transform: translate(-50%, -50%) translateY(8px) scale(var(--scl, 1));
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-body);
    background: var(--color-bg-primary);
    border: 1px solid color-mix(in srgb, var(--color-rule) var(--border-c, 100%), transparent);
    border-radius: 999px;
    padding: 0.28rem 0.7rem;
  }
  .cg-feature.is-in {
    opacity: var(--no, 1);
    transform: translate(-50%, -50%) scale(var(--scl, 1));
  }

  .cg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-sizing: border-box;
    flex: 0 0 auto;
  }
  .cg-dot.is-done { background: var(--color-ink-primary); }
  .cg-dot.is-active {
    background: var(--color-ink-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-ink-primary) 20%, transparent);
  }
  .cg-dot.is-queued { background: transparent; border: 1.5px solid var(--color-ink-muted); }

  /* Drill-down inspector popover. */
  .cg-inspector {
    position: absolute;
    z-index: 6;
    width: 17rem;
    transform: translate(-50%, 0) translateY(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    box-shadow: 0 16px 40px -18px color-mix(in srgb, var(--color-ink-primary) 50%, transparent);
    padding: 0.85rem 0.95rem;
  }
  .cg-inspector.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .cg-inspector::before {
    content: "";
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 11px;
    height: 11px;
    background: var(--color-bg-elevated);
    border-left: 1px solid var(--color-accent);
    border-top: 1px solid var(--color-accent);
  }
  .cg-inspector.is-flip::before {
    top: auto;
    bottom: -6px;
    border-left: none;
    border-top: none;
    border-right: 1px solid var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
  }
  .cg-insp-kind {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.3rem;
  }
  .cg-insp-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-ink-primary);
    margin: 0 0 0.6rem;
  }
  .cg-insp-sub {
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    margin: 0 0 0.55rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .cg-insp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cg-insp-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-ink-body);
  }
  .cg-insp-item .cg-insp-tag {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    flex: 0 0 auto;
    width: 4.1rem;
  }
  .cg-insp-foot {
    margin-top: 0.65rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
  }

  .cg-axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    z-index: 2;
  }
  .cg-tick {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    padding-top: 0.4rem;
  }
  .cg-tick::before {
    content: "";
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 1px;
    height: 0.4rem;
    background: var(--color-rule);
  }
  .cg-axisline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.1rem;
    height: 1px;
    background: var(--color-rule);
  }

  .cg-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
  }
  .cg-key { display: inline-flex; align-items: center; gap: 0.45rem; }
  .cg-thread-swatch {
    display: inline-block;
    width: 22px;
    height: 0;
    border-top: 1.5px dashed var(--color-accent);
    opacity: 0.85;
  }
  .cg-hint { margin-left: auto; opacity: 0.85; }

  @media (prefers-reduced-motion: reduce) {
    .cg-node,
    .cg-edges path,
    .cg-band-track,
    .cg-field circle,
    .cg-inspector,
    .cg-canvas {
      transition: none;
    }
    .cg-decision { opacity: var(--no, 1); transform: translate(-50%, -50%) scale(var(--scl, 1)); }
    .cg-feature { opacity: var(--no, 1); transform: translate(-50%, -50%) scale(var(--scl, 1)); }
    .cg-band-track { transform: scaleX(1); }
    .cg-edges path.cg-edge { opacity: var(--edge-o, 0.5); stroke-dashoffset: 0; }
    .cg-edges path.cg-thread { opacity: 0.7; }
    .cg-field circle { opacity: var(--mote-o, 0.16); }
  }

  @media (max-width: 700px) {
    .cg-hint { margin-left: 0; flex-basis: 100%; }
  }
</style>

<script>
  type CGState = "done" | "active" | "queued";

  interface CGPlanItem {
    tag: string;   // "Festival" | "Intent" | "Design" | "PR"
    text: string;
  }
  interface CGDecision {
    id: string;          // stable id for cross-project references
    decision: string;
    dt: number;          // time index the decision was made
    work?: string;       // the work it produced
    ft?: number;         // time index the work landed
    state: CGState;
    plan: CGPlanItem[];  // what the decision expands into (drill-down)
  }
  interface CGProject {
    name: string;        // project / repo name (a lane within the campaign)
    role: string;        // short descriptor (language / surface)
    start: number;       // lane start tick
    events: CGDecision[];
  }
  // Cross-project thread: a decision in one project unblocks work in another
  // project WITHIN the same campaign.
  interface CGLink {
    from: string; // source decision id
    to: string;   // target decision id (whose work it unblocked)
  }
  interface CGCampaign {
    id: string;
    name: string;
    kind: string;        // "Product" | "Consulting" | "Research" | ...
    stat: string;        // what it holds, e.g. "4 projects · 14 festivals · 31 intents"
    projects: CGProject[];
    links: CGLink[];
  }

  const TICKS = ["Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

  // How many additional (unshown) campaigns to imply beyond the named ones, so
  // the rail conveys the real scale (~19 total).
  const MORE_CAMPAIGNS = 13;

  // ILLUSTRATIVE portfolio. Each entry is a CAMPAIGN (a company / product /
  // effort). The graph shows ONE expanded at a time: its projects, decisions,
  // and the work they produced. Public-safe — a model, not live data.
  const CAMPAIGNS: CGCampaign[] = [
    {
      "id": "nw",
      "name": "Northwind Robotics",
      "kind": "Robotics",
      "stat": "7 projects · 24 festivals · 47 intents · since Mar",
      "projects": [
        {
          "name": "fleet-core",
          "role": "API · Go",
          "start": 0,
          "events": [
            {
              "id": "nw-fleet-1",
              "decision": "Adopt gRPC fleet control plane",
              "dt": 0,
              "ft": 2,
              "state": "done",
              "work": "control plane",
              "plan": [
                {
                  "tag": "Design",
                  "text": "control plane v1"
                },
                {
                  "tag": "Festival",
                  "text": "NW0002 — 3 phases"
                },
                {
                  "tag": "PR",
                  "text": "PR #14"
                }
              ]
            },
            {
              "id": "nw-fleet-2",
              "decision": "Add per-robot task lease arbitration",
              "dt": 3,
              "ft": 5,
              "state": "done",
              "work": "lease scheduler",
              "plan": [
                {
                  "tag": "Design",
                  "text": "lease model"
                },
                {
                  "tag": "Intent",
                  "text": "#31 stuck-robot recovery"
                },
                {
                  "tag": "PR",
                  "text": "PR #58"
                }
              ]
            },
            {
              "id": "nw-fleet-3",
              "decision": "Stream fleet state over WebSocket",
              "dt": 5,
              "ft": 7,
              "state": "active",
              "work": "state stream",
              "plan": [
                {
                  "tag": "Design",
                  "text": "event schema v2"
                },
                {
                  "tag": "Festival",
                  "text": "NW0011 — 2 phases"
                }
              ]
            },
            {
              "id": "nw-fleet-4",
              "decision": "Region-shard the dispatch queue",
              "dt": 8,
              "ft": 9,
              "state": "queued",
              "work": "sharded dispatch",
              "plan": [
                {
                  "tag": "Design",
                  "text": "shard key model"
                },
                {
                  "tag": "Intent",
                  "text": "#72 multi-DC fleets"
                }
              ]
            }
          ]
        },
        {
